# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
vendor/

# testing
coverage/

# production
build/
/.local

# misc
.DS_Store
.env.local
.env
.env.development.local
.env.test.local
.env.production.local

# local agent docs — stay at repo root so tools discover them, but never commit
AGENTS.md
CLAUDE.md
GEMINI.md
skills.md

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# customer-submitted bill payment receipts/proofs - never source-controlled
# content, unlike admin-curated brand/product catalog images which stay
# tracked since this project has no separate image hosting yet
/backend/public/uploads/bill-documents/*
!/backend/public/uploads/bill-documents/.gitkeep
# never commit local browser/agent files
.tmp-browser-profile/
SKILLS.md

# internal notes - not for the public repo
TODO.md
