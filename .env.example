# Local MySQL connection used by the backend
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=otu-zan-db
DB_USER=root
DB_PASSWORD=your-local-mysql-password

# Backend authentication secret; use a different local value per developer
JWT_SECRET=replace-with-a-long-random-secret
DRIVER_ACCESS_CODE=replace-with-driver-access-code
ADMIN_ACCESS_CODE=replace-with-admin-access-code

# Backend HTTP port
PORT=5000

# Frontend API origin
REACT_APP_API_URL=http://localhost:5000