# React frontend API
REACT_APP_API_URL=http://localhost:5000
# For a production build, REACT_APP_API_URL must be set to the deployed
# backend URL (e.g. in the hosting provider's build environment variables).
# react-scripts inlines it at `npm run build` time - editing it afterwards
# has no effect on an already-built bundle.
# Database and authentication settings belong in laravel/.env.
