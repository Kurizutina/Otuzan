APP_NAME=Otu-Zan
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false are both required -
# with APP_DEBUG=true any unhandled error returns a full stack trace with
# real server file paths to the raw HTTP response.
APP_DEBUG=false
# Production: set to the public URL of the deployed backend (https://...).
APP_URL=http://localhost:5000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=otu-zan-db
DB_USERNAME=root
DB_PASSWORD=
# Production: the deployed frontend origin, exactly (scheme + host, no
# trailing slash). CORS allows this origin and rejects every other one, and
# comma-separate multiple origins if needed (e.g. Vercel URL + custom domain).
FRONTEND_URL=http://localhost:3000
DRIVER_ACCESS_CODE=DRIVER2024
ADMIN_ACCESS_CODE=ADMIN2024
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
# MAIL_MAILER=log only writes emails (e.g. password resets) to storage/logs/laravel.log
# instead of actually sending them. Set real SMTP credentials to deliver mail for real,
# e.g. Gmail: host smtp.gmail.com, port 587, username your@gmail.com,
# password = a Google "App Password", encryption tls.
# Local development: reset emails are written to storage/logs/laravel.log.
# Switch to smtp only after supplying every SMTP setting below.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=deliveryotuzan@gmail.com
# Never put a real password here - this file is tracked by git. Each developer
# sets their own Gmail App Password in their local (gitignored) backend/.env.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=deliveryotuzan@gmail.com
MAIL_FROM_NAME="Otu-Zan"
MAIL_SCHEME=smtp