APP_NAME=Otu-Zan
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false are both required -
# with APP_DEBUG=true any unhandled error returns a full stack trace with
# real server file paths to the raw HTTP response.
APP_DEBUG=false
# Production: set to the public URL of the deployed backend (https://...).
APP_URL=http://localhost:5000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=otu-zan-db
DB_USERNAME=root
DB_PASSWORD=
# Production: the deployed frontend origin, exactly (scheme + host, no
# trailing slash). CORS allows this origin and rejects every other one, and
# comma-separate multiple origins if needed (e.g. Vercel URL + custom domain).
FRONTEND_URL=http://localhost:3000
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
# MAIL_MAILER=log only writes emails (e.g. password resets) to storage/logs/laravel.log
# instead of actually sending them. Local development: reset emails are written
# to storage/logs/laravel.log - leave this as log unless testing real delivery.
#
# Production: use MAIL_MAILER=sendgrid, not smtp. Railway blocks raw outbound
# SMTP (ports 25/587) on Free/Hobby plans - smtp (even with correct Gmail
# credentials) will hang and then fail there regardless of config. sendgrid
# sends over HTTPS instead, which isn't blocked. Sign up free at sendgrid.com,
# verify a Single Sender (your own email address - no domain purchase needed,
# unlike most other providers' free tiers), create an API key, and set it as
# SENDGRID_API_KEY on the host (never in this file). MAIL_FROM_ADDRESS must
# exactly match the verified Single Sender address.
MAIL_MAILER=log
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_FROM_NAME="Otu-Zan"
#
# smtp is kept as a fallback/local-testing option (e.g. with a Gmail App
# Password) - do not rely on it in production for the Railway reason above.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
# Never put a real password here - this file is tracked by git. Each developer
# sets their own Gmail App Password in their local (gitignored) backend/.env.
MAIL_PASSWORD=
MAIL_SCHEME=smtp